# Optional CLI RPC override. The UI uses public configuration and needs no .env.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# CLI scripts ONLY. A funded Hedera testnet ECDSA account is required.
# Use a 32-byte raw hex ECDSA key, never a DER key or an ED25519 key.
HEDERA_ACCOUNT_ID=
DEPLOYER_PRIVATE_KEY=

# Filled after deployment; public contract address, not a credential.
POOLPLEDGE_ADDRESS=

# Optional existing canonical SaucerSwap V1 testnet pair to register/prove.
# Leave blank to discover the WHBAR/SAUCE pair from the official factory.
PROOF_PAIR_ADDRESS=
# Full lifecycle proof: exact LP amount in base units. 0 uses a small part
# of the existing LP balance. Zero balance stops the proof without claiming success.
PROOF_LP_AMOUNT=0
# LP acquisition spends at most 0.1 HBAR swapping plus 0.1 HBAR pooling,
# excluding network fees. Only applies to the canonical WHBAR/SAUCE pair.
LP_HBAR_BUDGET=0.1
# Recovery only: set this and POOLPLEDGE_ADDRESS to withdraw an existing lock.
PROOF_LOCK_ID=
